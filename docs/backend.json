
{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Stores user roles and account details",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["user", "superuser"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "role"]
    },
    "Activity": {
      "title": "Activity",
      "description": "A log of automated detections and manual reports",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["Content", "User", "Report"] },
        "details": { "type": "string" },
        "status": { "type": "string", "enum": ["Flagged", "Pending", "Safe", "Action Taken"] },
        "date": { "type": "string", "format": "date-time" },
        "userId": { "type": "string" },
        "isCyberbullying": { "type": "boolean" },
        "isHighRisk": { "type": "boolean" },
        "isPotentialVictim": { "type": "boolean" },
        "reasoning": { "type": "string" },
        "originalText": { "type": "string" },
        "relType": { "type": "string" },
        "histType": { "type": "string" },
        "freq": { "type": "string" }
      },
      "required": ["type", "details", "status", "userId"]
    },
    "Relationship": {
      "title": "Relationship",
      "description": "Metadata about interactions between two users, including behavioral metrics",
      "type": "object",
      "properties": {
        "interactionCount": { "type": "number" },
        "relationshipType": { "type": "string" },
        "historyType": { "type": "string" },
        "interactionFrequency": { "type": "string" },
        "isBursting": { "type": "boolean", "description": "True if a user is flooding messages without response" },
        "rollingSentimentScore": { "type": "number" },
        "messageTimestamps": { 
          "type": "object", 
          "description": "Map of userId to array of recent interaction timestamps"
        },
        "participants": { "type": "array", "items": { "type": "string" } },
        "lastInteraction": { "type": "string", "format": "date-time" }
      },
      "required": ["participants"]
    },
    "ContextExample": {
      "title": "Context Example",
      "description": "Reference examples for AI few-shot learning",
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "relationship": { "type": "string" },
        "interaction_history": { "type": "string" },
        "interaction_frequency": { "type": "string" },
        "label": { "type": "string" },
        "sourceFile": { "type": "string" },
        "uploadedAt": { "type": "string", "format": "date-time" }
      }
    },
    "AdminSettings": {
      "title": "Admin Settings",
      "description": "System configurations for AI sensitivity and behavior per profile",
      "type": "object",
      "properties": {
        "profileType": { "type": "string", "description": "The name of the moderation profile (e.g., standard, strict, lenient)" },
        "sensitivityThreshold": { "type": "number", "description": "0-100 score" },
        "banterTolerance": { "type": "number", "description": "0-100 score" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["profileType", "sensitivityThreshold", "banterTolerance"]
    },
    "GlobalConfig": {
      "title": "Global Config",
      "description": "Global system configurations for active profiles",
      "type": "object",
      "properties": {
        "defaultProfileId": { "type": "string", "enum": ["standard", "guardian", "professional"] },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["defaultProfileId"]
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "#/backend/entities/UserProfile",
      "description": "User profile access"
    },
    "/activities/{activityId}": {
      "schema": "#/backend/entities/Activity",
      "description": "Activity log access"
    },
    "/relationships/{relationshipId}": {
      "schema": "#/backend/entities/Relationship",
      "description": "User relationship metadata"
    },
    "/contextExamples/{exampleId}": {
      "schema": "#/backend/entities/ContextExample",
      "description": "Read-only access to training examples"
    },
    "/moderationProfiles/{profileId}": {
      "schema": "#/backend/entities/AdminSettings",
      "description": "Moderation profile configurations"
    },
    "/adminSettings/global": {
      "schema": "#/backend/entities/GlobalConfig",
      "description": "Global administration settings"
    }
  }
}
